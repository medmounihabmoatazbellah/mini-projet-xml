<!ELEMENT real-estate (agencies, owners, properties, flats)>

<!-- agencies -->
<!ELEMENT agencies (agency*)>

<!ELEMENT agency (addresse-electronique, numero-telephone)>
<!ATTLIST agency 
nom ID #REQUIRED>
<!ELEMENT addresse-electronique (#PCDATA)>
<!ELEMENT numero-telephone (#PCDATA)> 

<!-- owners -->
<!ELEMENT owners (owner*)>

<!ELEMENT owner EMPTY>
<!ATTLIST owner 
nom ID #REQUIRED>

<!-- properties -->
<!ELEMENT properties (property*)>

<!ELEMENT property (description, nombre-appartements,
caracteristiques)>
<!ATTLIST property
nom ID #REQUIRED
reference-proprietaire IDREF #REQUIRED>
<!ELEMENT description (#PCDATA | flatReference)*>
<!ELEMENT flatReference EMPTY>
<!ATTLIST flatReference
FlatName IDREF #REQUIRED>
<!ELEMENT nombre-appartements (#PCDATA)>
<!ELEMENT caracteristiques (#PCDATA)> 

<!-- Flats -->
<!ELEMENT flats (flat*)> 

<!ELEMENT flat (description, caracteristiques)>
<!ATTLIST flat
nom ID #REQUIRED
reference-immobilier IDREF #REQUIRED>